<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Ecommerce CMS Sequential Suite" parallel="none" thread-count="1" verbose="1">

    <test name="Regression Tests Sequential">
        <parameter name="BROWSER" value="chrome"/>
        <classes>
            <class name="com.anhtester.EcommerceCMS.User.testcases.LoginTest"/>
            <class name="com.anhtester.EcommerceCMS.User.testcases.OrderTest"/>
            <class name="com.anhtester.EcommerceCMS.User.testcases.ProfileTest"/>
            <class name="com.anhtester.EcommerceCMS.User.testcases.GetProductInfoTest"/>
        </classes>
    </test>
    <test name="Regression Tests Sequential2">
        <parameter name="BROWSER" value="edge"/>
        <classes>
            <class name="com.anhtester.EcommerceCMS.User.testcases.LoginTest"/>
            <class name="com.anhtester.EcommerceCMS.User.testcases.OrderTest"/>
            <class name="com.anhtester.EcommerceCMS.User.testcases.ProfileTest"/>
            <class name="com.anhtester.EcommerceCMS.User.testcases.GetProductInfoTest"/>
        </classes>
    </test>
</suite>
