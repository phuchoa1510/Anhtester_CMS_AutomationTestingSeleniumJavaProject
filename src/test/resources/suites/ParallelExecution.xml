<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Ecommerce CMS Parallel Suite" parallel="classes" thread-count="4" verbose="1">

    <test name="Regression Tests">
        <parameter name="BROWSER" value="chrome"/>
        <classes>
            <class name="com.anhtester.ecommercecms.user.testcases.LoginTest"/>
            <class name="com.anhtester.ecommercecms.user.testcases.OrderTest"/>
            <class name="com.anhtester.ecommercecms.user.testcases.UpdateProfileTest"/>
            <class name="com.anhtester.ecommercecms.user.testcases.GetProductInfoTest"/>
        </classes>
    </test>
    <test name="Regression Tests2">
        <parameter name="BROWSER" value="edge"/>
        <classes>
            <class name="com.anhtester.ecommercecms.user.testcases.LoginTest"/>
            <class name="com.anhtester.ecommercecms.user.testcases.OrderTest"/>
            <class name="com.anhtester.ecommercecms.user.testcases.UpdateProfileTest"/>
            <class name="com.anhtester.ecommercecms.user.testcases.GetProductInfoTest"/>
        </classes>
    </test>


</suite>
