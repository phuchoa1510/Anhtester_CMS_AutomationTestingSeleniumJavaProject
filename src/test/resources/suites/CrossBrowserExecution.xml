<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Step-by-Step Suite" parallel="tests" thread-count="2" verbose="1">

    <test name="Login - Chrome">
        <parameter name="BROWSER" value="chrome"/>
        <classes>
            <class name="com.anhtester.EcommerceCMS.User.testcases.LoginTest"/>
        </classes>
    </test>
    <test name="Login - Edge">
        <parameter name="BROWSER" value="edge"/>
        <classes>
            <class name="com.anhtester.EcommerceCMS.User.testcases.LoginTest"/>
        </classes>
    </test>

</suite>
