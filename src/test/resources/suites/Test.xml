<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<suite name="Suite Demo Parallel Testing By Methods" verbose="1">
    <test name="Login Test" parallel="methods" thread-count="4">
        <classes>
            <class name="com.anhtester.EcommerceCMS.User.testcases.LoginTest"/>
        </classes>
    </test>
    <test name="Manage Profile Test" parallel="methods" thread-count="3">
        <classes>
            <class name="com.anhtester.EcommerceCMS.User.testcases.ProfileTest"/>
        </classes>
    </test>
    <test name="Get Product Info" parallel="methods" thread-count="2">
        <classes>
            <class name="com.anhtester.EcommerceCMS.User.testcases.GetProductInfoTest"/>
        </classes>
    </test>
    <listeners>
        <listener class-name="com.anhtester.listeners.TestListener"/>
    </listeners>

</suite>